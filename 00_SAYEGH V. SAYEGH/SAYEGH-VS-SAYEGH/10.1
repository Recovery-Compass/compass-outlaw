import os
import textwrap
from reportlab.pdfgen import canvas
from reportlab.lib.pagesizes import LETTER

# --- MASTER PHYSICS ENGINE v10.1 (CRC COMPLIANT) ---
LEADING = 24.0      # Double Spacing
LINE_1_Y = 720.0    # Top Text Line
LEFT_RAIL_X = 85.0  # Left Margin
TEXT_START_X = 95.0 # Text Start
GUTTER_X = 300.0    # Caption Split
RIGHT_RAIL_X = 550.0# Right Margin

def get_line_y(line_num):
    return LINE_1_Y - ((line_num - 1) * LEADING)

def draw_pleading_paper(c, page_num, case_no, title, footer_text):
    # 1. DOUBLE RAIL (LEFT)
    c.setLineWidth(1.0)
    c.line(LEFT_RAIL_X, 50, LEFT_RAIL_X, 760)       # Inner Rail
    c.line(LEFT_RAIL_X - 6, 50, LEFT_RAIL_X - 6, 760) # Outer Rail
    
    # 2. SINGLE RAIL (RIGHT)
    c.line(RIGHT_RAIL_X, 50, RIGHT_RAIL_X, 760)

    # 3. LINE NUMBERS (Aligned to Baseline)
    c.setFont("Courier", 12)
    for i in range(1, 29):
        # Adjusted Y to align perfectly with Times-Roman baseline
        c.drawRightString(LEFT_RAIL_X - 10, get_line_y(i) - 2, str(i))

    # 4. FOOTER
    c.setFont("Times-Roman", 10)
    c.line(LEFT_RAIL_X - 6, 50, RIGHT_RAIL_X, 50) # Bottom Border
    c.drawCentredString(LETTER[0]/2, 30, f"{title} | Case: {case_no} | Page {page_num}")

def draw_caption(c, case_no, doc_title, judge, date="TBD"):
    # ATTORNEY INFO
    c.setFont("Times-Roman", 12)
    header = [
        "NUHA SAYEGH",
        "5634 Noel Drive, Temple City, CA 91780",
        "(626) 348-3039 | Petitioner In Pro Per"
    ]
    y = get_line_y(1)
    for line in header:
        c.drawString(TEXT_START_X, y, line)
        y -= LEADING

    # COURT TITLE
    c.setFont("Times-Bold", 12)
    c.drawCentredString(LETTER[0]/2, get_line_y(8), "SUPERIOR COURT OF THE STATE OF CALIFORNIA")
    c.drawCentredString(LETTER[0]/2, get_line_y(9), "FOR THE COUNTY OF LOS ANGELES - PASADENA")

    # CAPTION BOX
    top_y = get_line_y(11) + 12
    bot_y = get_line_y(19) - 5
    
    # Vertical Divider Line
    c.line(GUTTER_X, top_y, GUTTER_X, bot_y)
    
    # Left Side (Parties)
    c.setFont("Times-Roman", 12)
    c.drawString(TEXT_START_X, get_line_y(11), "In re Marriage of:")
    c.drawString(TEXT_START_X, get_line_y(12), "NUHA SAYEGH, Petitioner,")
    c.drawString(TEXT_START_X, get_line_y(13), "and")
    c.drawString(TEXT_START_X, get_line_y(14), "FAHED SAYEGH, Respondent.")

    # Right Side (Case Info)
    c.drawString(GUTTER_X + 10, get_line_y(11), f"Case No.: {case_no}")
    
    # Title Logic (Auto-Scale)
    c.setFont("Times-Bold", 11) # Slightly smaller to fit
    # Split title if too long
    if len(doc_title) > 30:
        parts = textwrap.wrap(doc_title, 30)
        ty = get_line_y(12)
        for part in parts:
            c.drawString(GUTTER_X + 10, ty, part)
            ty -= LEADING
    else:
        c.drawString(GUTTER_X + 10, get_line_y(12), doc_title)

    c.setFont("Times-Roman", 11)
    c.drawString(GUTTER_X + 10, get_line_y(15), f"Date: {date}")
    c.drawString(GUTTER_X + 10, get_line_y(16), "Time: 8:30 AM")
    c.drawString(GUTTER_X + 10, get_line_y(17), "Dept: L")
    c.drawString(GUTTER_X + 10, get_line_y(18), f"Judge: {judge}")

    # Bottom Line
    c.line(TEXT_START_X, bot_y, RIGHT_RAIL_X, bot_y)

