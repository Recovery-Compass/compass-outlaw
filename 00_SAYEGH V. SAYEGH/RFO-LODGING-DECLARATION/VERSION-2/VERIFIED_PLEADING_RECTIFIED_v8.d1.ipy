:"08963218265582152221"}},"outputId":"65298a82-529d-460c-fdac-540a5c3b160c"},"source":["# 1. PARSE AND CLEAN /content/10.4 context.txt\n","import re\n","import os\n","\n","file_path = '/content/10.4 context.txt'\n","output_script = 'physics_engine_v30.py'\n","\n","with open(file_path, 'r') as f:\n","    content = f.read()\n","\n","print(f\"--- PROCESSING {file_path} ---\")\n","\n","# Attempt to find code block markers\n","match = re.search(r'```python(.*?)```', content, re.DOTALL)\n","\n","code_to_exec = \"\"\n","if match:\n","    print(\"--- CODE BLOCK FOUND VIA REGEX ---\")\n","    code_to_exec = match.group(1)\n","else:\n","    # Fallback: Look for import statement\n","    print(\"--- REGEX FAILED. SEARCHING FOR IMPORTS ---\")\n","    start_marker = \"import textwrap\"\n","    if start_marker in content:\n","        start_index = content.find(start_marker)\n","        code_to_exec = content[start_index:]\n","        print(\"--- CODE BLOCK EXTRACTED VIA SIGNATURE ---\")\n","\n","if code_to_exec.strip():\n","    # Save to file for cleaner execution\n","    with open(output_script, 'w') as f_out:\n","        f_out.write(code_to_exec)\n","\n","    print(f\"--- EXECUTING {output_script} ---\")\n","    try:\n","        # Execute the extracted script\n","        !python3 {output_script}\n","        print(\"--- EXECUTION COMPLETE ---\")\n","    except Exception as e:\n","        print(f\"--- EXECUTION ERROR: {e} ---\")\n","else:\n","    print(\"--- ERROR: NO VALID PYTHON CODE FOUND ---\")\n","    print(content[:500]) # Debug preview"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["--- PROCESSING /content/10.4 context.txt ---\n","--- CODE BLOCK FOUND VIA REGEX ---\n","--- EXECUTING physics_engine_v30.py ---\n",">>> INITIATING PLATINUM MASTER FORGE (v40.0)...\n","✅ DOC 1: PLATINUM RFO GENERATED.\n","✅ DOC 2: PLATINUM DECLARATION GENERATED.\n","✅ DOC 3: PLATINUM NOTICE GENERATED.\n","--- EXECUTION COMPLETE ---\n"]}]},{"cell_type":"code","